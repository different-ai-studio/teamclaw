# teamclaw-fc — environment template for Docker self-host.
# Copy to .env and fill in. The full authoritative list lives in s.yaml.

# --- container-specific ---
PORT=9000
HOST=0.0.0.0
CRON_TRIGGER_SECRET=
BACKEND_KIND=supabase

# --- core (see s.yaml for the complete set) ---
SUPABASE_URL=
SUPABASE_PUBLIC_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=
# DATABASE_URL / POSTGRES_* for the postgres backend
DATABASE_URL=

# --- OSS / object storage ---
ACCESS_KEY_ID=
ACCESS_KEY_SECRET=
ROLE_ARN=
BUCKET=teamclaw-team
REGION=cn-shenzhen
ENDPOINT=https://oss-cn-shenzhen.aliyuncs.com

# --- MQTT ---
# MQTT_BROKER_URL is how *FC itself* reaches the broker (the inbox publisher in
# push-deps.ts), AND — unless overridden below — the address
# GET /v1/config/bootstrap hands to clients. When FC and clients reach the
# broker at the same place (Alibaba FC / belayo), this is the only var to set.
MQTT_BROKER_URL=
# MQTT_PUBLIC_BROKER_URL is an OVERRIDE, needed only where those two addresses
# differ. Self-host is that case: compose points FC at `mqtt://emqx:1883` and
# the all-in-one image at `mqtt://127.0.0.1:1883`, neither of which resolves
# outside the container, so clients must be given the public hostname here.
#
# Leave it empty when it does not apply — blank is treated as unset. It used to
# be read with `??`, which counts "" as a real value; since every deployment
# declares it with an empty default, that dropped the whole `mqtt` block while
# still answering 200. Clients then reported no broker address and nothing else
# noticed — the daemon never reads this endpoint, so it stayed connected and
# masked the outage (issue #634).
#
# If BOTH are empty the `mqtt` block is omitted entirely and real-time sync is
# off; that is still a silent 200, so check it after any deploy.
MQTT_PUBLIC_BROKER_URL=
# Raw-TCP address for clients whose MQTT stack can't do WebSocket (iOS
# CocoaMQTT, Expo). Only needed when MQTT_PUBLIC_BROKER_URL is a ws(s):// URL —
# with an mqtt:// public broker those clients already use it directly.
MQTT_PUBLIC_TCP_BROKER_URL=

# --- LiteLLM (optional) ---
LITELLM_URL=
LITELLM_MASTER_KEY=
