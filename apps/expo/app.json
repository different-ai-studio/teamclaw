        "@sentry/react-native",
        {
          "organization": "ucar-inc",
          "project": "teamclu-expo"
        }
      ]
    ],
    "ios": {
      "bundleIdentifier": "com.bertrand319.teamcluexpo"
    },
    "extra": {
      "eas": {
        "projectId": "d68ed240-fe6c-4180-a1b4-305faff315ff"
